# ============ MHM FARMS — ENVIRONMENT ============
# Copie este ficheiro para `.env` e ajuste os valores.

# Porta da API
PORT=4000

# CORS: origens permitidas (separa por vírgula). "*" permite todas as origens.
CLIENT_ORIGIN=http://localhost:5173

# Segredo JWT (use um valor longo e aleatório em produção)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Base de dados
# Por predefinição o projeto usa SQLite (zero configuração) para desenvolvimento.
DATABASE_URL="file:./dev.db"

# Para PostgreSQL em produção, descomente e use:
# DATABASE_URL="postgresql://user:password@localhost:5432/mhmfarms?schema=public"

# Para MySQL/MariaDB em produção, descomente e use (e altere o provider em prisma/schema.prisma):
# DATABASE_URL="mysql://user:password@localhost:3306/mhmfarms"

# Credenciais do primeiro administrador (gerado pelo seed se ainda não existir)
ADMIN_EMAIL=admin@mhmfarms.com
ADMIN_PASSWORD=Admin123!

# URL pública base (usada nos emails de recuperação de senha)
PUBLIC_BASE_URL=http://localhost:5173