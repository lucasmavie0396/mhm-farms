// MHM Farms — Prisma schema
// Base de dados principal: MySQL/MariaDB (ex.: XAMPP)
// Para desenvolvimento rápido sem MySQL pode voltar a "sqlite" e ajustar DATABASE_URL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum AnimalCategory {
  MAMIFERO
  AVE
  REPTIL
  DOMESTICO
  OUTRO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PublicationStatus {
  ACTIVE
  INACTIVE
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum SchoolVisitStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        TicketSale[]
}

model Animal {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  species           String
  family            String?
  category          AnimalCategory
  habitat           String?
  diet              String?
  lifeExpectancy    String?
  description       String    @db.Text
  curiosity         String?   @db.Text
  funFact           String?   @db.Text
  behavior          String?   @db.Text
  featured          Boolean       @default(false)
  active            Boolean       @default(true)
  mainImage         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  images            AnimalImage[]
  experiences       Experience[]
}

model AnimalImage {
  id        String @id @default(cuid())
  animalId  String
  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String    @db.Text
  alt       String?
  sortOrder Int    @default(0)
}

enum ExperienceType {
  VISITA
  ALIMENTACAO
  PASSEIO
  EDUCACAO
  FAMILIA
  EVENTO
  AVENTURA
}

model Experience {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  shortDesc   String    @db.Text
  description String?   @db.Text
  image       String    @db.Text
  type        ExperienceType
  duration    String
  minAge      String
  price       Float            @default(0)
  availability Boolean         @default(true)
  featured    Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  animalId    String?
  animal      Animal?          @relation(fields: [animalId], references: [id])
  reservations Reservation[]
}

model Event {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  date           DateTime
  time           String
  location       String
  description    String    @db.Text
  image          String    @db.Text
  price          Float     @default(0)
  maxParticipants Int?
  active         Boolean @default(true)
  featured       Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Reservation {
  id           String            @id @default(cuid())
  code         String            @unique
  date         DateTime
  time         String
  adults       Int               @default(1)
  children     Int               @default(0)
  totalVisitors Int
  visitType    String
  name         String
  phone        String
  email        String
  notes        String?   @db.Text
  experienceId String?
  experience   Experience?       @relation(fields: [experienceId], references: [id])
  status       ReservationStatus @default(PENDING)
  totalPrice   Float             @default(0)
  breakdown    Json?
  payments     ReservationPayment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ReservationPayment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Float
  method        String
  stage         String
  paidAt        DateTime
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

model SchoolVisit {
  id           String            @id @default(cuid())
  schoolName   String
  teacherName  String
  email        String
  phone        String
  numStudents  Int
  numTeachers  Int
  schoolLevel  String?
  preferredDate DateTime?
  message      String?   @db.Text
  status       SchoolVisitStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryItem {
  id        String  @id @default(cuid())
  title     String?
  category  String  @default("animais")
  type      String  @default("IMAGE")
  url       String    @db.Text
  videoUrl  String?   @db.Text
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

model News {
  id        String @id @default(cuid())
  slug      String @unique
  title     String
  content   String    @db.LongText
  image     String?   @db.Text
  date      DateTime
  author    String
  category  String
  active    Boolean @default(true)
  featured  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id       String @id @default(cuid())
  question String  @db.Text
  answer   String  @db.LongText
  category String @default("geral")
  order    Int    @default(0)
  active   Boolean @default(true)
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String        @db.Text
  message   String        @db.LongText
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.LongText
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String    @db.Text
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model TicketSale {
  id            String    @id @default(cuid())
  code          String    @unique
  date          DateTime  @default(now())
  items         Json
  totalPrice    Float
  totalVisitors Int       @default(0)
  paymentMethod String
  customerName  String?
  status        String    @default("PAID")
  sellerId      String?
  seller        User?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
}